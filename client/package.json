{
  "name": "pulse-client",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse — a real-time chat platform simulation (Next.js + TypeScript + Tailwind + Zustand)",
  "scripts": {
    "predev": "node scripts/sync-public.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/sync-public.mjs",
    "build": "next build",
    "start": "npx serve out -l 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
